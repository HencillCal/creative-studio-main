# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Google Gemini ────────────────────────────────────────────────────────────
# Comma-separated keys — they rotate automatically when one hits quota
# Get free keys at: https://aistudio.google.com/app/apikey
GEMINI_API_KEYS=your_gemini_key_here,optional_second_key

# ─── AI/ML API (optional) ────────────────────────────────────────────────────
# Used as OCR fallback. Keys: https://aimlapi.com/app/api-keys
AIML_API_KEYS=

# ─── OpenAI (optional) ───────────────────────────────────────────────────────
# Used as GPT-4o vision OCR fallback. Keys: https://platform.openai.com/api-keys
OPENAI_API_KEYS=

# ─── Google Cloud Vision (optional) ──────────────────────────────────────────
# Get key: https://console.cloud.google.com/apis/credentials
GOOGLE_VISION_API_KEYS=

# ─── Azure Computer Vision (optional) ────────────────────────────────────────
AZURE_CV_KEY=
AZURE_CV_ENDPOINT=

# ─── AWS Textract (optional) ─────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─── OCR.space (optional) ────────────────────────────────────────────────────
# Free key: https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEYS=

# ─── Ops alerts (optional) ───────────────────────────────────────────────────
# Slack-compatible webhook for background-task failure alerts
OPS_ALERT_WEBHOOK_URL=
